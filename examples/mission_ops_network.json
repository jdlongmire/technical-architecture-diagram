        {"id": "vpn", "label": "VPN Concentrator", "stereotype": "appliance", "detail": "10.10.0.5"},
        {"id": "proxy", "label": "Reverse Proxy", "stereotype": "server", "detail": "10.10.0.20"}
      ]},
      {"id": "ops", "label": "Ops Enclave", "type": "enclave", "marking": "CUI", "containers": [
