          {"id": "mps", "label": "Mission Planning", "stereotype": "app server", "detail": "10.20.1.10"},
          {"id": "cmd", "label": "Command Server", "stereotype": "app server", "detail": "10.20.1.11"},
          {"id": "tlm", "label": "Telemetry Processor", "stereotype": "app server", "detail": "10.20.1.12"},
          {"id": "fdy", "label": "Flight Dynamics", "stereotype": "app server", "detail": "10.20.1.13"}
        ]},
        {"id": "data", "label": "Data Zone", "type": "zone", "nodes": [
          {"id": "archive", "label": "Telemetry Archive", "shape": "cylinder", "detail": "10.20.2.10"},
          {"id": "opsdb", "label": "Ops Database", "shape": "cylinder", "detail": "10.20.2.11"}
        ]},
        {"id": "ws", "label": "Operator Workstations", "type": "group", "nodes": [
